{
  "obsidian": {
    "vaultPath": "/Users/brooklyn/Documents/obsidian",
    "_vaultPath_note": "Set this to the absolute path of your Obsidian vault. Alternatively: export OBSIDIAN_VAULT_PATH=/path/to/vault. See docs/obsidian-sync-guide.md.",
    "projectFolder": "PROJECTS",
    "attachmentsFolder": "attachments",
    "include": [
      "README.md",
      "AGENTS.md",
      "CLAUDE.md",
      "SUMMARY.md",
      "docs/**/*.md",
      "setup-doc/**/*.md",
      ".pi/**/*.md"
    ],
    "exclude": [
      ".git/**",
      "node_modules/**",
      ".DS_Store"
    ],
    "rewriteImageLinks": true
  },
  "defaultProvider": "openrouter",
  "defaultModel": "anthropic/claude-sonnet-5",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "lastChangelogVersion": "0.84.4",
  "theme": "dark",
  "hideThinkingBlock": false,
  "enabledModels": [
    "openrouter/anthropic/claude-sonnet-5",
    "openrouter/z-ai/glm-5.3",
    "openrouter/moonshotai/kimi-k3",
    "openrouter/deepseek/deepseek-v4-pro",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "ollama/qwen3:4b-instruct",
    "llmhub/claude-sonnet-4.6"
  ],
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "contextPrune": {
    "enabled": true,
    "showPruneStatusLine": true,
    "summarizerModel": "openrouter/openai/gpt-4.1-mini",
    "summarizerThinking": "default",
    "pruneOn": "agent-message",
    "batchingMode": "turn",
    "quietOversizedSkips": false,
    "minBatchChars": 1000,
    "recoveryGraceTurns": 3,
    "summarizerIdleTimeoutMs": 20000,
    "summarizerMaxTimeoutMs": 180000,
    "protectedTools": [],
    "protectedPaths": [
      "**/.env*",
      "**/auth.json",
      "**/.ssh/**",
      "**/.gnupg/**",
      "**/node_modules/**",
      "**/.git/**"
    ],
    "chainCompression": {
      "enabled": true,
      "rollingWindow": 3,
      "stripFinalAssistantThinking": true,
      "fuseRangeSummary": true
    },
    "purgeErrors": {
      "enabled": true,
      "cooldownTurns": 2,
      "minArgChars": 500
    },
    "dedupByContentHash": true,
    "autoBudgetThreshold": 0.3,
    "spillThreshold": 65536,
    "spillPreviewBytes": 2048,
    "budgetTurnDelta": null,
    "summarizerConcurrency": 2
  },
  "packages": [
    "npm:pi-web-access",
    "npm:pi-condense@2.9.1"
  ]
}
