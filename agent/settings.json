{
  "obsidian": {
    "vaultPath": "/Users/A94984797/Documents/ObsidianVault",
    "_vaultPath_note": "Set this to the absolute path of your Obsidian vault. Alternatively: export OBSIDIAN_VAULT_PATH=/path/to/vault. See docs/obsidian-sync-guide.md.",
    "projectFolder": "PROJECTS",
    "attachmentsFolder": "attachments",
    "include": [
      "README.md",
      "AGENTS.md",
      "CLAUDE.md",
      "SUMMARY.md",
      "docs/**/*.md",
      "setup-doc/**/*.md",
      ".pi/**/*.md"
    ],
    "exclude": [
      ".git/**",
      "node_modules/**",
      ".DS_Store"
    ],
    "rewriteImageLinks": true
  },
  "defaultProvider": "otc-internal",
  "defaultModel": "GLM-5.2",
  "defaultThinkingLevel": "medium",
  "lastChangelogVersion": "0.85.0",
  "theme": "dark",
  "hideThinkingBlock": false,
  "quietStartup": true,
  "showCacheMissNotices": true,
  "enabledModels": [
    "ollama/*",
    "otc-internal/*",
    "openrouter/anthropic/claude-sonnet-4.6",
    "openrouter/anthropic/claude-sonnet-5",
    "openrouter/moonshotai/kimi-k2.6",
    "ai-engineer/*",
    "llmhub/*"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "packages": [
    "npm:pi-web-access",
    "npm:pi-condense@2.9.1",
    "npm:cache-warm",
    "npm:pi-lens",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:statusline-pi",
    "npm:@plannotator/pi-extension",
    "npm:advisor-pi"
  ],
  "contextPrune": {
    "enabled": true,
    "showPruneStatusLine": false,
    "summarizerModel": "otc-internal/gpt-oss-120b",
    "summarizerThinking": "default",
    "pruneOn": "agent-message",
    "batchingMode": "turn",
    "quietOversizedSkips": false,
    "minBatchChars": 1000,
    "recoveryGraceTurns": 3,
    "summarizerIdleTimeoutMs": 20000,
    "summarizerMaxTimeoutMs": 180000,
    "protectedTools": [],
    "protectedPaths": [
      "**/.env*",
      "**/auth.json",
      "**/.ssh/**",
      "**/.gnupg/**",
      "**/node_modules/**",
      "**/.git/**"
    ],
    "chainCompression": {
      "enabled": true,
      "rollingWindow": 3,
      "stripFinalAssistantThinking": true,
      "fuseRangeSummary": true
    },
    "purgeErrors": {
      "enabled": true,
      "cooldownTurns": 2,
      "minArgChars": 500
    },
    "dedupByContentHash": true,
    "autoBudgetThreshold": 0.3,
    "spillThreshold": 65536,
    "spillPreviewBytes": 2048,
    "budgetTurnDelta": null,
    "summarizerConcurrency": 2
  },
  "extensions": []
}